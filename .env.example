# Copia este archivo a .env y ajusta los valores.

# Cadena de conexión a PostgreSQL.
# Desarrollo: base local levantada con `docker compose up -d` (credenciales de docker-compose.yml).
# Producción (Neon): usa la URL que entrega Neon, con ?sslmode=require.
DATABASE_URL="postgresql://cuadre:cuadre@localhost:5432/cuadre?schema=public"
