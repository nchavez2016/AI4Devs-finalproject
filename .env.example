# Copia este archivo a .env y ajusta los valores.

# Cadena de conexión a PostgreSQL.
# Desarrollo: base local levantada con `docker compose up -d` (credenciales de docker-compose.yml).
# Producción (Neon): usa la URL que entrega Neon, con ?sslmode=require.
DATABASE_URL="postgresql://cuadre:cuadre@localhost:5432/cuadre?schema=public"

# Secreto usado por Auth.js para firmar la sesión (JWT). Obligatorio, mínimo 32 caracteres.
# Genera uno con: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# Opcional. Base de datos usada por los tests de integración (npm run test:run).
# Debe terminar en "_test": el código se niega a limpiar o migrar cualquier otra base.
# Si se omite, se usa por defecto la base local "cuadre_test" en el mismo contenedor de
# docker-compose.yml; el globalSetup de Vitest la crea y migra automáticamente.
# TEST_DATABASE_URL="postgresql://cuadre:cuadre@localhost:5432/cuadre_test?schema=public"
