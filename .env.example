# Copia este archivo a .env y ajusta los valores.

# Cadena de conexión a PostgreSQL.
# Desarrollo: base local levantada con `docker compose up -d` (credenciales de docker-compose.yml).
# Producción (Neon): usa la URL que entrega Neon, con ?sslmode=require.
DATABASE_URL="postgresql://cuadre:cuadre@localhost:5432/cuadre?schema=public"

# Secreto usado por Auth.js para firmar la sesión (JWT). Obligatorio, mínimo 32 caracteres.
# Genera uno con: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# Opcional. Base de datos usada por los tests de integración (npm run test:run).
# Debe terminar en "_test": el código se niega a limpiar o migrar cualquier otra base.
# Si se omite, se usa por defecto la base local "cuadre_test" en el mismo contenedor de
# docker-compose.yml; el globalSetup de Vitest la crea y migra automáticamente.
# TEST_DATABASE_URL="postgresql://cuadre:cuadre@localhost:5432/cuadre_test?schema=public"

# Tests E2E (npm run test:e2e): no requieren variables nuevas. Usan el mismo servidor y las
# mismas credenciales que TEST_DATABASE_URL (o su valor por defecto) pero la base propia
# "cuadre_e2e_test", que Prisma crea y migra sola. El AUTH_SECRET de la app E2E es ficticio y
# está en playwright.config.ts; el .env de desarrollo no se usa para arrancarla.
# Evidencias opcionales: con E2E_EVIDENCIA=1 (p. ej. `E2E_EVIDENCIA=1 npm run test:e2e`) el flujo
# principal guarda capturas de /panel a 360 y 1280 px en docs/evidencias/e2e/. Sin la variable
# no se escribe nada. Las capturas se commitean a mano, no en cada ejecución.
# E2E_EVIDENCIA=1

# Seed del usuario revisor (npm run db:seed). Solo se ejecuta a mano. Debe ser IGUAL al nombre
# de la base de DATABASE_URL; si falta o no coincide, el seed se detiene sin tocar nada.
# Contra Neon: exporta DATABASE_URL (URL directa) y SEED_CONFIRMAR_BASE solo en esa terminal,
# junto con AUTH_SECRET (cualquier valor de 32+ caracteres; el seed no firma sesiones).
# SEED_CONFIRMAR_BASE="cuadre"
