BRANCH=$(git rev-parse --abbrev-ref HEAD)
if [ "$BRANCH" = "main" ] || [ "$BRANCH" = "master" ]; then
  echo "ERROR: no se hacen commits directos en $BRANCH. Trabaja en la rama de la entrega."
  exit 1
fi

# Cada tasks.md de un change activo en stage exige su progress.md en stage.
# El patrón no cubre openspec/changes/archive/<change>/tasks.md.
STAGED=$(git diff --cached --name-only --diff-filter=ACMR)
for TASKS in $(echo "$STAGED" | grep -E '^openspec/changes/[^/]+/tasks\.md$'); do
  # Solo exige progress.md cuando este commit marca alguna casilla como hecha.
  if git diff --cached -U0 -- "$TASKS" | grep -qE '^\+- \[x\]'; then
    CHANGE=$(echo "$TASKS" | cut -d/ -f3)
    if ! echo "$STAGED" | grep -qxF "openspec/changes/$CHANGE/progress.md"; then
      echo "ERROR: $CHANGE: se marcaron tareas sin actualizar progress.md."
      exit 1
    fi
  fi
done

# Clases del tema por defecto de Tailwind (tokens.md, 3.2): no generan CSS y no fallan el build.
node scripts/diseno/comprobar-clases.mjs || exit 1

npm run lint || exit 1
npm run typecheck || exit 1
npm run test:run || exit 1
